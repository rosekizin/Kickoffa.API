{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug"
    },
    "WriteTo": {
      "Console": {
        "Enabled": true
      },
      "File": {
        "Enabled": true,
        "Path": "logs/test-.txt",
        "FileSizeLimitMB": 10,
        "RetainedFileCountLimit": 5
      }
    },
    "Enrich": {
      "Enabled": true
    },
    "OutputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff}] [{Level:u3}] {Message:lj}{NewLine}{Exception}"
  }
}
